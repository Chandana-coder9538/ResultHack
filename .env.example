# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE DATABASE & STORAGE CONFIGURATION
# ==============================================================================
# All reads/writes run server-side only through service role client.
# Row Level Security (RLS) is enabled on all tables with zero public access.
#
# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
PROJECT_URL=""

# Supabase Publishable / Anon Key (server-side only)
PUBLISHABLE_KEY=""

# Supabase Service Role Key (bypasses RLS server-side)
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# MULTI-TENANT RESULT ANALYSIS PLATFORM - EMAIL & SMTP CONFIGURATION
# ==============================================================================
# Used to dispatch 6-digit OTP verification codes for college & department registration,
# password resets, and account deletion authorizations.
#
# SMTP Server Host (e.g., smtp.gmail.com)
SMTP_HOST=""

# SMTP Server Port (587 for STARTTLS, 465 for SSL/TLS)
SMTP_PORT="587"

# SMTP Authentication Username / Email address
SMTP_USER=""

# SMTP Authentication Password or Gmail App Password
SMTP_PASS=""

# Sender Name and Address displayed to colleges and departments
SMTP_FROM="Academic Result Analysis Vault <no-reply@marks-analyzer.edu>"

# Master encryption secret for encrypted data-at-rest
ENCRYPTION_SECRET="ubdt-academic-marks-encryption-vault-2026"

# ==============================================================================
# DEVELOPMENT & TESTING MODE
# ==============================================================================
# Set to "true" during development to log generated OTPs to the server console.
# Keep "false" or unset in production to prevent logging secrets or codes.
DEV_MODE="false"
