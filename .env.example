# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# MULTI-TENANT RESULT ANALYSIS PLATFORM - EMAIL & SMTP CONFIGURATION
# ==============================================================================
# Used to dispatch 6-digit OTP verification codes for college & department registration
# and password resets.
#
# If SMTP variables are not configured, the platform operates in Demo/Development Mode:
# OTP codes are securely logged to the console and displayed in the UI notification
# for testing and immediate evaluation.

# SMTP Server Host (e.g., smtp.gmail.com, smtp.sendgrid.net, smtp.mailgun.org, smtp-relay.brevo.com)
SMTP_HOST=""

# SMTP Server Port (587 for STARTTLS, 465 for SSL/TLS, 25)
SMTP_PORT="587"

# SMTP Authentication Username / Email address
SMTP_USER=""

# SMTP Authentication Password or App-Specific Password
SMTP_PASS=""

# Sender Name and Address displayed to colleges and departments
SMTP_FROM="Academic Result Analysis Vault <no-reply@marks-analyzer.edu>"

# Optional: Master encryption secret for SQLite data-at-rest encryption
ENCRYPTION_SECRET="ubdt-academic-marks-encryption-vault-2026"
